rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /_internal_/test {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'liamradah10@gmail.com' ||
        request.auth.token.email == 'admin.peter@pharmagh.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    function isAdminScopedForProfile(adminUid, cadre) {
      return exists(/databases/$(database)/documents/regulatoryBodyAdmins/$(adminUid))
        && (cadre in get(/databases/$(database)/documents/regulatoryBodyAdmins/$(adminUid)).data.scopedCadres)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'credentialVerificationStatus',
          'credentialVerifiedAt',
          'credentialVerifiedByBody',
          'credentialVerifiedByUid',
          'credentialRejectionReason',
          'practisingLicenceStatus',
          'practisingLicenceYear',
          'licenceRenewalDate',
          'licenceExpiryDate',
          'licenceSuspensionReason',
          'updatedAt'
        ]);
    }

    match /regulatoryBodyAdmins/{adminUid} {
      allow read: if request.auth != null
        && (isAdmin()
        || request.auth.uid == adminUid);
      allow write: if request.auth != null
        && isAdmin();
    }

    match /verificationDocuments/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId
        || isAdmin()
        || exists(/databases/$(database)/documents/regulatoryBodyAdmins/$(request.auth.uid)));
      allow create, update: if request.auth != null
        && request.auth.uid == userId;
    }

    match /individualProfiles/{userId} {
      allow read: if request.auth != null;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if request.auth != null
        && (request.auth.uid == userId
        || isAdmin()
        || (exists(/databases/$(database)/documents/regulatoryBodyAdmins/$(request.auth.uid))
            && isAdminScopedForProfile(request.auth.uid, resource.data.primaryCadre)));
      allow delete: if isAdmin();
    }

    match /organisationProfiles/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    match /jobPostings/{jobId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    match /availabilityPosts/{postId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    match /interestEvents/{eventId} {
      allow read, write: if isSignedIn();
    }

    match /platformStats/{docId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    match /businessListings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerUserId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.sellerUserId == request.auth.uid || isAdmin());
    }

    match /messages/{conversationId} {
      allow read, write: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      match /messageThread/{messageId} {
        allow read, write: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/messages/$(conversationId)).data.participants;
      }
    }

    match /contentFlags/{flagId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.reporterUserId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isAdmin();
    }

    match /platformConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
