rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveMember() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'ACTIVE';
    }

    function isAdmin() {
      return isSignedIn()
        && ('admin' in request.auth.token)
        && request.auth.token.admin == true;
    }

    function isAuthorityAdmin() {
      let adminPath = /databases/$(database)/documents/professionalAuthorityAdmins/$(request.auth.uid);
      return isSignedIn()
        && ('authority_admin' in request.auth.token)
        && request.auth.token.authority_admin == true
        && exists(adminPath)
        && get(adminPath).data.isActive == true
        && exists(
          /databases/$(database)/documents/professionalAuthorities/$(get(adminPath).data.authorityId)
        )
        && get(
          /databases/$(database)/documents/professionalAuthorities/$(get(adminPath).data.authorityId)
        ).data.isActive == true;
    }

    function authorityAdminHasCadre(cadre) {
      let adminRecord = get(/databases/$(database)/documents/professionalAuthorityAdmins/$(request.auth.uid)).data;
      return isAuthorityAdmin()
        && (cadre in adminRecord.scopedCadres)
        && exists(/databases/$(database)/documents/professionalAuthorities/$(adminRecord.authorityId))
        && (
          cadre in get(/databases/$(database)/documents/professionalAuthorities/$(adminRecord.authorityId)).data.governedCadres
        );
    }

    function authorityRoleIsOneOf(roles) {
      return isAuthorityAdmin()
        && get(/databases/$(database)/documents/professionalAuthorityAdmins/$(request.auth.uid)).data.role in roles;
    }

    function authorityCanAccessProfessional(userId) {
      return isAuthorityAdmin()
        && exists(/databases/$(database)/documents/individualProfiles/$(userId))
        && authorityAdminHasCadre(
          get(/databases/$(database)/documents/individualProfiles/$(userId)).data.primaryCadre
        );
    }

    function canVerifyProfessional(userId) {
      return authorityCanAccessProfessional(userId)
        && authorityRoleIsOneOf(['authority_super_admin', 'verification_officer']);
    }

    function canManageComplianceProfessional(userId) {
      return authorityCanAccessProfessional(userId)
        && authorityRoleIsOneOf(['authority_super_admin', 'compliance_officer']);
    }

    function isAuthorityVerificationProfileUpdate(cadre) {
      return authorityAdminHasCadre(cadre)
        && authorityRoleIsOneOf(['authority_super_admin', 'verification_officer'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'credentialVerificationStatus',
          'credentialVerifiedAt',
          'credentialVerifiedByBody',
          'credentialVerifiedByUid',
          'credentialRejectionReason',
          'isDirectoryVisible',
          'updatedAt'
        ])
        && request.resource.data.isDirectoryVisible == false;
    }

    function isAuthorityComplianceProfileUpdate(userId, cadre) {
      let accountAfter = getAfter(/databases/$(database)/documents/users/$(userId)).data;
      return authorityAdminHasCadre(cadre)
        && authorityRoleIsOneOf(['authority_super_admin', 'compliance_officer'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'practisingLicenceStatus',
          'practisingLicenceYear',
          'licenceRenewalDate',
          'licenceExpiryDate',
          'licenceSuspensionReason',
          'isDirectoryVisible',
          'updatedAt'
        ])
        && request.resource.data.isDirectoryVisible
          == (
            accountAfter.isActive == true
            && accountAfter.accountStatus == 'ACTIVE'
            && request.resource.data.profileCompleteness >= 60
          );
    }

    function isAuthorityVerificationAccountUpdate(userId) {
      return canVerifyProfessional(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'accountStatus',
          'isActive',
          'isVerified',
          'updatedAt'
        ])
        && (
          (
            request.resource.data.accountStatus == 'MORE_INFORMATION_REQUIRED'
            && request.resource.data.isActive == false
            && request.resource.data.isVerified == false
          )
          || (
            request.resource.data.accountStatus == 'REJECTED'
            && request.resource.data.isActive == false
            && request.resource.data.isVerified == false
          )
          || (
            request.resource.data.accountStatus == 'INACTIVE_ANNUAL_COMPLIANCE'
            && request.resource.data.isActive == false
            && request.resource.data.isVerified == true
          )
        );
    }

    function isAuthorityComplianceAccountUpdate(userId) {
      return canManageComplianceProfessional(userId)
        && resource.data.isVerified == true
        && request.resource.data.isVerified == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'accountStatus',
          'isActive',
          'isVerified',
          'updatedAt'
        ])
        && (
          (
            request.resource.data.accountStatus == 'ACTIVE'
            && request.resource.data.isActive == true
          )
          || (
            request.resource.data.accountStatus == 'INACTIVE_ANNUAL_COMPLIANCE'
            && request.resource.data.isActive == false
          )
          || (
            request.resource.data.accountStatus == 'SUSPENDED_BY_AUTHORITY'
            && request.resource.data.isActive == false
          )
        );
    }

    function currentAccountType() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType;
    }

    function validJobQuotaAssignment(ownerId, jobId) {
      let slotKey = request.resource.data.quotaSlot;
      let slotId = 'job_' + slotKey;
      return slotKey in ['0', '1', '2', '3', '4']
        && existsAfter(/databases/$(database)/documents/postingQuotaSlots/$(ownerId)/slots/$(slotId))
        && getAfter(/databases/$(database)/documents/postingQuotaSlots/$(ownerId)/slots/$(slotId)).data.ownerUserId == ownerId
        && getAfter(/databases/$(database)/documents/postingQuotaSlots/$(ownerId)/slots/$(slotId)).data.resourceType == 'job'
        && getAfter(/databases/$(database)/documents/postingQuotaSlots/$(ownerId)/slots/$(slotId)).data.slotKey == slotKey
        && getAfter(/databases/$(database)/documents/postingQuotaSlots/$(ownerId)/slots/$(slotId)).data.postingId == jobId
        && getAfter(/databases/$(database)/documents/postingQuotaSlots/$(ownerId)/slots/$(slotId)).data.expiresAt == request.resource.data.expiresAt;
    }

    function validAvailabilityQuotaAssignment(ownerId, postId) {
      let slotKey = request.resource.data.quotaSlot;
      let slotId = 'availability_' + slotKey;
      return slotKey == '0'
        && existsAfter(/databases/$(database)/documents/postingQuotaSlots/$(ownerId)/slots/$(slotId))
        && getAfter(/databases/$(database)/documents/postingQuotaSlots/$(ownerId)/slots/$(slotId)).data.ownerUserId == ownerId
        && getAfter(/databases/$(database)/documents/postingQuotaSlots/$(ownerId)/slots/$(slotId)).data.resourceType == 'availability'
        && getAfter(/databases/$(database)/documents/postingQuotaSlots/$(ownerId)/slots/$(slotId)).data.slotKey == slotKey
        && getAfter(/databases/$(database)/documents/postingQuotaSlots/$(ownerId)/slots/$(slotId)).data.postingId == postId
        && getAfter(/databases/$(database)/documents/postingQuotaSlots/$(ownerId)/slots/$(slotId)).data.expiresAt == request.resource.data.expiresAt;
    }

    function validBusinessQuotaAssignment(ownerId, listingId) {
      let slotKey = request.resource.data.quotaSlot;
      let slotId = 'business_' + slotKey;
      return slotKey in ['0', '1', '2']
        && existsAfter(/databases/$(database)/documents/postingQuotaSlots/$(ownerId)/slots/$(slotId))
        && getAfter(/databases/$(database)/documents/postingQuotaSlots/$(ownerId)/slots/$(slotId)).data.ownerUserId == ownerId
        && getAfter(/databases/$(database)/documents/postingQuotaSlots/$(ownerId)/slots/$(slotId)).data.resourceType == 'business'
        && getAfter(/databases/$(database)/documents/postingQuotaSlots/$(ownerId)/slots/$(slotId)).data.slotKey == slotKey
        && getAfter(/databases/$(database)/documents/postingQuotaSlots/$(ownerId)/slots/$(slotId)).data.postingId == listingId
        && getAfter(/databases/$(database)/documents/postingQuotaSlots/$(ownerId)/slots/$(slotId)).data.expiresAt == request.resource.data.expiresAt;
    }

    function previousQuotaTargetIsReusable() {
      let targetId = resource.data.postingId;
      return (
          resource.data.resourceType == 'job'
          && (
            !exists(/databases/$(database)/documents/jobPostings/$(targetId))
            || get(/databases/$(database)/documents/jobPostings/$(targetId)).data.status != 'active'
            || get(/databases/$(database)/documents/jobPostings/$(targetId)).data.expiresAt <= request.time
          )
        )
        || (
          resource.data.resourceType == 'availability'
          && (
            !exists(/databases/$(database)/documents/availabilityPosts/$(targetId))
            || get(/databases/$(database)/documents/availabilityPosts/$(targetId)).data.status != 'active'
            || get(/databases/$(database)/documents/availabilityPosts/$(targetId)).data.expiresAt <= request.time
          )
        )
        || (
          resource.data.resourceType == 'business'
          && (
            !exists(/databases/$(database)/documents/businessListings/$(targetId))
            || get(/databases/$(database)/documents/businessListings/$(targetId)).data.status != 'active'
            || get(/databases/$(database)/documents/businessListings/$(targetId)).data.expiresAt <= request.time
          )
        );
    }

    function quotaSlotPayloadIsValid(ownerId, slotId) {
      let type = request.resource.data.resourceType;
      let slotKey = request.resource.data.slotKey;
      let postingId = request.resource.data.postingId;
      return request.resource.data.keys().hasOnly([
          'ownerUserId',
          'resourceType',
          'slotKey',
          'postingId',
          'expiresAt',
          'updatedAt'
        ])
        && request.resource.data.ownerUserId == ownerId
        && (
          (
            type == 'job'
            && slotKey in ['0', '1', '2', '3', '4']
            && slotId == 'job_' + slotKey
            && existsAfter(/databases/$(database)/documents/jobPostings/$(postingId))
            && getAfter(/databases/$(database)/documents/jobPostings/$(postingId)).data.organisationUserId == ownerId
            && getAfter(/databases/$(database)/documents/jobPostings/$(postingId)).data.quotaSlot == slotKey
            && getAfter(/databases/$(database)/documents/jobPostings/$(postingId)).data.status == 'active'
            && getAfter(/databases/$(database)/documents/jobPostings/$(postingId)).data.expiresAt > request.time
            && request.resource.data.expiresAt == getAfter(/databases/$(database)/documents/jobPostings/$(postingId)).data.expiresAt
          )
          || (
            type == 'availability'
            && slotKey == '0'
            && slotId == 'availability_' + slotKey
            && existsAfter(/databases/$(database)/documents/availabilityPosts/$(postingId))
            && getAfter(/databases/$(database)/documents/availabilityPosts/$(postingId)).data.individualUserId == ownerId
            && getAfter(/databases/$(database)/documents/availabilityPosts/$(postingId)).data.quotaSlot == slotKey
            && getAfter(/databases/$(database)/documents/availabilityPosts/$(postingId)).data.status == 'active'
            && getAfter(/databases/$(database)/documents/availabilityPosts/$(postingId)).data.expiresAt > request.time
            && request.resource.data.expiresAt == getAfter(/databases/$(database)/documents/availabilityPosts/$(postingId)).data.expiresAt
          )
          || (
            type == 'business'
            && slotKey in ['0', '1', '2']
            && slotId == 'business_' + slotKey
            && existsAfter(/databases/$(database)/documents/businessListings/$(postingId))
            && getAfter(/databases/$(database)/documents/businessListings/$(postingId)).data.sellerUserId == ownerId
            && getAfter(/databases/$(database)/documents/businessListings/$(postingId)).data.quotaSlot == slotKey
            && getAfter(/databases/$(database)/documents/businessListings/$(postingId)).data.status == 'active'
            && getAfter(/databases/$(database)/documents/businessListings/$(postingId)).data.expiresAt > request.time
            && request.resource.data.expiresAt == getAfter(/databases/$(database)/documents/businessListings/$(postingId)).data.expiresAt
          )
        );
    }

    function validJobInterestIncrement(jobId) {
      let eventId = 'job_interest__' + jobId + '__' + request.auth.uid;
      return isActiveMember()
        && currentAccountType() == 'individual'
        && request.resource.data.organisationUserId == resource.data.organisationUserId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestCount'])
        && request.resource.data.interestCount == resource.data.interestCount + 1
        && !exists(/databases/$(database)/documents/interestEvents/$(eventId))
        && existsAfter(/databases/$(database)/documents/interestEvents/$(eventId));
    }

    function validAvailabilityInterestIncrement(postId) {
      let eventId = 'availability_interest__' + postId + '__' + request.auth.uid;
      return isActiveMember()
        && currentAccountType() == 'organisation'
        && request.resource.data.individualUserId == resource.data.individualUserId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestCount'])
        && request.resource.data.interestCount == resource.data.interestCount + 1
        && !exists(/databases/$(database)/documents/interestEvents/$(eventId))
        && existsAfter(/databases/$(database)/documents/interestEvents/$(eventId));
    }

    function professionalVerificationFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'credentialVerificationStatus',
        'credentialVerifiedAt',
        'credentialVerifiedByBody',
        'credentialVerifiedByUid',
        'credentialRejectionReason',
        'practisingLicenceStatus',
        'practisingLicenceYear',
        'licenceRenewalDate',
        'licenceExpiryDate',
        'licenceSuspensionReason'
      ]);
    }

    function verifiedProfessionalIdentityFieldsUnchanged() {
      return resource.data.credentialVerificationStatus != 'verified'
        || (
          request.resource.data.fullName == resource.data.fullName
          && request.resource.data.primaryCadre == resource.data.primaryCadre
          && request.resource.data.registrationNumber == resource.data.registrationNumber
        );
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.id == request.auth.uid
        && request.resource.data.isVerified == false
        && (
          (
            request.resource.data.accountType == 'individual'
            && request.resource.data.accountClass == 'professional'
            && request.resource.data.accountStatus == 'PENDING_PROFILE'
            && request.resource.data.isActive == false
          )
          || (
            request.resource.data.accountType == 'organisation'
            && request.resource.data.accountClass == 'organisation'
            && request.resource.data.accountStatus == 'ACTIVE'
            && request.resource.data.isActive == true
          )
        );

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.id == resource.data.id
        && request.resource.data.accountType == resource.data.accountType
        && request.resource.data.accountClass == resource.data.accountClass
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.isVerified == resource.data.isVerified
        && (
          request.resource.data.accountStatus == resource.data.accountStatus
          || (
            resource.data.accountStatus in ['PENDING_PROFILE', 'MORE_INFORMATION_REQUIRED']
            && request.resource.data.accountStatus == 'PENDING_AUTHORITY_VERIFICATION'
            && resource.data.isActive == false
          )
        );

      allow update: if isAuthorityVerificationAccountUpdate(userId)
        || isAuthorityComplianceAccountUpdate(userId);

      allow read, write: if isAdmin();
    }

    match /professionalAuthorities/{authorityId} {
      allow read: if isAdmin()
        || (
          isAuthorityAdmin()
          && authorityId
            == get(/databases/$(database)/documents/professionalAuthorityAdmins/$(request.auth.uid)).data.authorityId
        );
      // Authority lifecycle changes are trusted-backend only.
      allow write: if false;
    }

    match /professionalAuthorityAdmins/{adminUid} {
      allow read: if isAdmin()
        || (
          isAuthorityAdmin()
          && resource.data.authorityId
            == get(/databases/$(database)/documents/professionalAuthorityAdmins/$(request.auth.uid)).data.authorityId
        );
      // Staff role/scope changes are trusted-backend only.
      allow write: if false;
    }

    match /verificationDocuments/{userId} {
      allow read: if isSignedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
          || authorityCanAccessProfessional(userId)
        );

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.submissionStatus == 'pending_review'
        && request.resource.data.keys().hasAll([
          'userId',
          'submittedAt',
          'submittedForYear',
          'submissionType',
          'submissionStatus'
        ])
        && request.resource.data.keys().hasOnly([
          'userId',
          'registrationCertificatePath',
          'practisingCertificatePath',
          'registrationCertificateUrl',
          'practisingCertificateUrl',
          'additionalDocumentUrls',
          'submittedAt',
          'submittedForYear',
          'submissionType',
          'submissionStatus'
        ]);

      allow update: if isSignedIn() && (
        (
          request.auth.uid == userId
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.submissionStatus == 'pending_review'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'registrationCertificatePath',
            'practisingCertificatePath',
            'registrationCertificateUrl',
            'practisingCertificateUrl',
            'additionalDocumentUrls',
            'submittedAt',
            'submittedForYear',
            'submissionType',
            'submissionStatus'
          ])
        )
        || (
          (isAdmin() || canVerifyProfessional(userId))
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'reviewedAt',
            'reviewedByUid',
            'reviewedByBody',
            'reviewNotes',
            'submissionStatus'
          ])
          && request.resource.data.submissionStatus in [
            'approved',
            'rejected',
            'more_information_required'
          ]
        )
      );

      allow delete: if isAdmin();
    }

    match /individualProfiles/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || (
          isActiveMember()
          && resource.data.isDirectoryVisible == true
          && resource.data.profileCompleteness >= 60
        )
        || isAdmin()
        || authorityAdminHasCadre(resource.data.primaryCadre)
      );
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.isDirectoryVisible == false;
      allow update: if isSignedIn() && (
        (
          request.auth.uid == userId
          && professionalVerificationFieldsUnchanged()
          && verifiedProfessionalIdentityFieldsUnchanged()
          && request.resource.data.isDirectoryVisible
            == (
              get(/databases/$(database)/documents/users/$(userId)).data.isActive == true
              && get(/databases/$(database)/documents/users/$(userId)).data.accountStatus == 'ACTIVE'
              && request.resource.data.profileCompleteness >= 60
            )
        )
        || isAdmin()
        || isAuthorityVerificationProfileUpdate(resource.data.primaryCadre)
        || isAuthorityComplianceProfileUpdate(userId, resource.data.primaryCadre)
      );
      allow delete: if isAdmin();
    }

    match /organisationProfiles/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || isActiveMember()
        || isAdmin()
      );
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
      allow read, write: if isAdmin();
    }

    match /jobPostings/{jobId} {
      allow get: if isAdmin()
        || (
          isActiveMember()
          && (
            resource.data.organisationUserId == request.auth.uid
            || (
              resource.data.status == 'active'
              && resource.data.expiresAt > request.time
            )
          )
        );
      allow list: if isAdmin();
      allow list: if isActiveMember()
        && resource.data.organisationUserId == request.auth.uid;
      // Firestore list rules cannot safely prove a client-side clock value against request.time.
      // Browse queries still filter expiresAt; list authorization therefore enforces status,
      // while direct document reads enforce both status and wall-clock expiry.
      allow list: if isActiveMember()
        && resource.data.status == 'active';
      allow create: if isActiveMember()
        && request.resource.data.organisationUserId == request.auth.uid
        && currentAccountType() == 'organisation'
        && request.resource.data.status == 'active'
        && request.resource.data.interestCount == 0
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(60, 'd')
        && validJobQuotaAssignment(request.auth.uid, jobId);
      allow update: if isAdmin()
        || (
          isActiveMember()
          && resource.data.organisationUserId == request.auth.uid
          && request.resource.data.organisationUserId == resource.data.organisationUserId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.interestCount == resource.data.interestCount
          && request.resource.data.status in ['active', 'closed', 'expired']
          && !(resource.data.status == 'closed' && request.resource.data.status == 'active')
          && request.resource.data.expiresAt <= request.time + duration.value(60, 'd')
          && (
            request.resource.data.expiresAt == resource.data.expiresAt
            || (
              resource.data.expiresAt <= request.time
              && request.resource.data.status == 'active'
              && request.resource.data.expiresAt > request.time
              && validJobQuotaAssignment(request.auth.uid, jobId)
            )
          )
          && (
            (
              !('quotaSlot' in resource.data)
              && !('quotaSlot' in request.resource.data)
            )
            || (
              ('quotaSlot' in resource.data)
              && ('quotaSlot' in request.resource.data)
              && request.resource.data.quotaSlot == resource.data.quotaSlot
            )
            || (
              resource.data.expiresAt <= request.time
              && validJobQuotaAssignment(request.auth.uid, jobId)
            )
          )
        )
        || validJobInterestIncrement(jobId);
      allow delete: if isAdmin()
        || (
          isActiveMember()
          && resource.data.organisationUserId == request.auth.uid
        );
    }

    match /availabilityPosts/{postId} {
      allow get: if isAdmin()
        || (
          isActiveMember()
          && (
            resource.data.individualUserId == request.auth.uid
            || (
              resource.data.status == 'active'
              && resource.data.expiresAt > request.time
            )
          )
        );
      allow list: if isAdmin();
      allow list: if isActiveMember()
        && resource.data.individualUserId == request.auth.uid;
      allow list: if isActiveMember()
        && resource.data.status == 'active';
      allow create: if isActiveMember()
        && request.resource.data.individualUserId == request.auth.uid
        && currentAccountType() == 'individual'
        && request.resource.data.status == 'active'
        && request.resource.data.interestCount == 0
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(60, 'd')
        && validAvailabilityQuotaAssignment(request.auth.uid, postId);
      allow update: if isAdmin()
        || (
          isActiveMember()
          && resource.data.individualUserId == request.auth.uid
          && request.resource.data.individualUserId == resource.data.individualUserId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.interestCount == resource.data.interestCount
          && request.resource.data.status in ['active', 'closed', 'expired']
          && !(resource.data.status == 'closed' && request.resource.data.status == 'active')
          && request.resource.data.expiresAt <= request.time + duration.value(60, 'd')
          && (
            request.resource.data.expiresAt == resource.data.expiresAt
            || (
              resource.data.expiresAt <= request.time
              && request.resource.data.status == 'active'
              && request.resource.data.expiresAt > request.time
              && validAvailabilityQuotaAssignment(request.auth.uid, postId)
            )
          )
          && (
            (
              !('quotaSlot' in resource.data)
              && !('quotaSlot' in request.resource.data)
            )
            || (
              ('quotaSlot' in resource.data)
              && ('quotaSlot' in request.resource.data)
              && request.resource.data.quotaSlot == resource.data.quotaSlot
            )
            || (
              resource.data.expiresAt <= request.time
              && validAvailabilityQuotaAssignment(request.auth.uid, postId)
            )
          )
        )
        || validAvailabilityInterestIncrement(postId);
      allow delete: if isAdmin()
        || (
          isActiveMember()
          && resource.data.individualUserId == request.auth.uid
        );
    }

    match /interestEvents/{eventId} {
      allow create: if isActiveMember()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'actorId',
          'targetId',
          'type',
          'timestamp'
        ])
        && (
          (
            request.resource.data.type == 'job_interest'
            && currentAccountType() == 'individual'
            && eventId == 'job_interest__' + request.resource.data.targetId + '__' + request.auth.uid
            && exists(/databases/$(database)/documents/jobPostings/$(request.resource.data.targetId))
            && get(/databases/$(database)/documents/jobPostings/$(request.resource.data.targetId)).data.status == 'active'
            && get(/databases/$(database)/documents/jobPostings/$(request.resource.data.targetId)).data.expiresAt > request.time
          )
          || (
            request.resource.data.type == 'availability_interest'
            && currentAccountType() == 'organisation'
            && eventId == 'availability_interest__' + request.resource.data.targetId + '__' + request.auth.uid
            && exists(/databases/$(database)/documents/availabilityPosts/$(request.resource.data.targetId))
            && get(/databases/$(database)/documents/availabilityPosts/$(request.resource.data.targetId)).data.status == 'active'
            && get(/databases/$(database)/documents/availabilityPosts/$(request.resource.data.targetId)).data.expiresAt > request.time
          )
        );
      allow read: if isActiveMember() && resource.data.actorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /platformStats/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    match /businessListings/{listingId} {
      allow get: if isAdmin()
        || (
          isActiveMember()
          && (
            resource.data.sellerUserId == request.auth.uid
            || (
              resource.data.status in ['active', 'under_offer']
              && resource.data.expiresAt > request.time
            )
          )
        );
      allow list: if isAdmin();
      allow list: if isActiveMember()
        && resource.data.sellerUserId == request.auth.uid;
      allow list: if isActiveMember()
        && resource.data.status == 'active';
      allow list: if isActiveMember()
        && resource.data.status == 'under_offer';
      allow create: if isActiveMember()
        && request.resource.data.sellerUserId == request.auth.uid
        && request.resource.data.photoUrls is list
        && request.resource.data.photoUrls.size() <= 3
        && request.resource.data.status == 'active'
        && request.resource.data.viewCount == 0
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(90, 'd')
        && validBusinessQuotaAssignment(request.auth.uid, listingId);
      allow update: if isAdmin()
        || (
          isActiveMember()
          && resource.data.sellerUserId == request.auth.uid
          && request.resource.data.sellerUserId == resource.data.sellerUserId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.viewCount == resource.data.viewCount
          && request.resource.data.photoUrls is list
          && request.resource.data.photoUrls.size() <= 3
          && request.resource.data.status in ['active', 'under_offer', 'sold', 'withdrawn']
          && (
            request.resource.data.status == resource.data.status
            || (
              resource.data.status == 'active'
              && request.resource.data.status in ['under_offer', 'sold', 'withdrawn']
            )
            || (
              resource.data.status == 'under_offer'
              && request.resource.data.status in ['sold', 'withdrawn']
            )
          )
          && request.resource.data.expiresAt <= request.time + duration.value(90, 'd')
          && (
            request.resource.data.expiresAt == resource.data.expiresAt
            || (
              resource.data.status == 'active'
              && request.resource.data.status == 'active'
              && resource.data.expiresAt <= request.time + duration.value(14, 'd')
              && request.resource.data.expiresAt > request.time
              && validBusinessQuotaAssignment(request.auth.uid, listingId)
            )
          )
          && (
            (
              !('quotaSlot' in resource.data)
              && !('quotaSlot' in request.resource.data)
            )
            || (
              ('quotaSlot' in resource.data)
              && ('quotaSlot' in request.resource.data)
              && request.resource.data.quotaSlot == resource.data.quotaSlot
            )
            || (
              resource.data.status == 'active'
              && resource.data.expiresAt <= request.time + duration.value(14, 'd')
              && validBusinessQuotaAssignment(request.auth.uid, listingId)
            )
          )
        );
      allow delete: if isAdmin()
        || (
          isActiveMember()
          && resource.data.sellerUserId == request.auth.uid
        );
    }

    match /postingQuotaSlots/{ownerId}/slots/{slotId} {
      allow read: if isAdmin()
        || (
          isActiveMember()
          && request.auth.uid == ownerId
        );

      allow create: if isActiveMember()
        && request.auth.uid == ownerId
        && quotaSlotPayloadIsValid(ownerId, slotId);

      allow update: if isActiveMember()
        && request.auth.uid == ownerId
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.resourceType == resource.data.resourceType
        && request.resource.data.slotKey == resource.data.slotKey
        && (
          request.resource.data.postingId == resource.data.postingId
          || previousQuotaTargetIsReusable()
        )
        && quotaSlotPayloadIsValid(ownerId, slotId);

      allow delete: if isAdmin();
    }

    match /businessListingPrivate/{listingId} {
      allow read: if isAdmin()
        || (
          isActiveMember()
          && resource.data.sellerUserId == request.auth.uid
        )
        || (
          isActiveMember()
          && exists(/databases/$(database)/documents/businessListings/$(listingId))
          && get(/databases/$(database)/documents/businessListings/$(listingId)).data.isConfidential == false
          && get(/databases/$(database)/documents/businessListings/$(listingId)).data.status in ['active', 'under_offer']
          && get(/databases/$(database)/documents/businessListings/$(listingId)).data.expiresAt > request.time
        );

      allow create: if isActiveMember()
        && request.resource.data.sellerUserId == request.auth.uid;

      allow update: if isAdmin()
        || (
          isActiveMember()
          && resource.data.sellerUserId == request.auth.uid
          && request.resource.data.sellerUserId == resource.data.sellerUserId
        );

      allow delete: if isAdmin()
        || (
          isActiveMember()
          && resource.data.sellerUserId == request.auth.uid
        );
    }

    match /messages/{conversationId} {
      allow read: if isActiveMember() && request.auth.uid in resource.data.participants;
      allow create: if isActiveMember()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1];
      allow update: if isActiveMember()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'lastMessageAt',
          'lastMessageSenderId',
          'unreadCount'
        ])
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadCount'])
          || request.resource.data.lastMessageSenderId == request.auth.uid
        );
      allow delete: if isAdmin();

      match /messageThread/{messageId} {
        allow read: if isActiveMember()
          && request.auth.uid in get(/databases/$(database)/documents/messages/$(conversationId)).data.participants;
        allow create: if isActiveMember()
          && request.auth.uid in get(/databases/$(database)/documents/messages/$(conversationId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000;
        allow update, delete: if false;
      }
    }

    match /contentFlags/{flagId} {
      allow create: if isSignedIn() && request.resource.data.reporterUserId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.reporterUserId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /platformConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Privilege audit records are created only by trusted Admin SDK tooling.
    // Platform admins may inspect them, but no client (including an admin UI)
    // may create, alter or delete the audit trail.
    match /privilegeAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
